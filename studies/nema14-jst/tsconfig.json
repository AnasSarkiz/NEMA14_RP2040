{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "tscircuit",
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "controller.tsx",
    "src",
    "scripts/*.ts",
    "tscircuit.config.ts",
    "experiments/integrated/*.ts",
    "experiments/integrated/*.tsx",
    "experiments/reachability/*.ts",
    "experiments/reachability/*.tsx",
    "experiments/compatibility/*.tsx",
    "experiments/compatibility/*.ts",
    "experiments/compact/*.tsx",
    "experiments/compact/*.ts",
    "experiments/anchored/*.ts",
    "experiments/anchored/*.tsx"
  ]
}
