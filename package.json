{
  "name": "NEMA14_RP2040",
  "version": "2.0.0-dev.1",
  "description": "NEMA14 RP2040 V2: checked four-layer routing, winding telemetry and WAGO spring terminal",
  "main": "index.circuit.tsx",
  "scripts": {
    "build": "npm run build:v2 && npm run check:v2",
    "check": "npm run check:v2",
    "dev": "XDG_CONFIG_HOME=/workspace/.config tsci dev index.circuit.json",
    "test": "npm run check",
    "render": "bun scripts/render.ts",
    "autoroute": "bun scripts/build.tsx",
    "source:check": "npm run build:v2 && npm run check:v2:source",
    "export": "npm run check:v2 && /workspace/.routing-venv/bin/python scripts/export-manufacturing.py",
    "typecheck": "tsc --noEmit",
    "shorts": "XDG_CONFIG_HOME=/workspace/.config tsci check shorts artifacts/board.circuit.json --mode gerber --layer all --pixels-per-mm 100",
    "publish:tscircuit": "bash scripts/publish-tscircuit.sh",
    "presentation": "npm run source:check && python3 scripts/sync-presentation.py && npm run render && /workspace/.routing-venv/bin/python scripts/export-a4-pdf.py && /workspace/.routing-venv/bin/python scripts/report-presentation.py",
    "check:copper": "/workspace/.routing-venv/bin/python scripts/audit-trace-widths.py",
    "check:mounts": "python3 scripts/check-mount-drills.py && /workspace/.routing-venv/bin/python scripts/check-mechanical-mounts.py",
    "check:manufacturing": "/workspace/.routing-venv/bin/python scripts/audit-manufacturing.py --render",
    "check:schematic": "tsci check schematic-placement artifacts/board.circuit.json && /workspace/.routing-venv/bin/python scripts/verify-schematic.py",
    "check:schema": "node scripts/check-native-schema.mjs",
    "precheck": "python3 scripts/patch-native-circular-keepouts.py",
    "check:circle": "bun scripts/check-circle-regression.ts",
    "assembly:build": "npm run check:v2 && bun scripts/build-assembly-preview.tsx",
    "assembly:check": "npm run check:v2 && /workspace/.routing-venv/bin/python scripts/check-harness-connection.py && /workspace/.routing-venv/bin/python scripts/check-assembly-fit.py",
    "assembly:export": "npm run check:v2 && bun scripts/export-assembly-3d.ts && /workspace/.routing-venv/bin/python scripts/check-exported-harness.py",
    "assembly:viewer": "bun build scripts/assembly-viewer.mjs --target browser --minify --outfile artifacts/top-assembly/assembly-viewer.js",
    "publish:assembly": "npm run check:v2 && python3 scripts/prepare-assembly-release.py",
    "check:pd": "python3 scripts/check-ch224a.py",
    "build:v2": "bun scripts/build-v2.tsx",
    "route:v2": "python3 scripts/restore-v2-reviewed-routing.py",
    "route:v2:native": "bun scripts/route-v2.tsx",
    "check:v2:routing": "/workspace/.routing-venv/bin/python scripts/audit-v2-routing.py --source artifacts/v2/routing/freerouted.circuit.json --output artifacts/v2/routing/physical-routing-audit.json",
    "check:v2:routing:native": "bun scripts/check-v2-routing.ts",
    "render:v2:routing": "bun scripts/render-v2-routing.ts",
    "check:v2": "python3 scripts/check-v2.py --require-release",
    "check:v2:source": "python3 scripts/check-v2.py && node scripts/check-native-schema.mjs artifacts/v2/source.circuit.json && bun scripts/check-v2-drills.ts",
    "check:v2:placement": "/workspace/.routing-venv/bin/python scripts/verify-v2-placement.py",
    "render:v2:placement": "/workspace/.routing-venv/bin/python scripts/render-v2-placement.py",
    "preview:v2:portable": "python3 scripts/make-v2-portable-viewer.py",
    "check:v2:schematic": "tsci check schematic-placement artifacts/v2/source.circuit.json",
    "route:v2:freerouting": "/workspace/.routing-venv/bin/python scripts/route-v2-freerouting.py",
    "check:v2:functional": "/workspace/.routing-venv/bin/python scripts/audit-v2-functional-routing.py --source artifacts/v2/routing/freerouted.circuit.json",
    "check:v2:phase-current": "/workspace/.routing-venv/bin/python scripts/screen-v2-phase-current.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnasSarkiz/NEMA14_RP2040.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AnasSarkiz/NEMA14_RP2040/issues"
  },
  "homepage": "https://github.com/AnasSarkiz/NEMA14_RP2040",
  "dependencies": {
    "@tscircuit/cli": "^0.1.2261",
    "circuit-json-to-gerber": "0.0.112",
    "circuit-json-to-kicad": "0.0.230",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-reconciler": "0.34.0",
    "three": "0.186.1",
    "tscircuit": "^0.0.2764",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "schematic-symbols": "0.0.248"
  },
  "devDependencies": {
    "bun": "1.4.2"
  },
  "private": true
}
